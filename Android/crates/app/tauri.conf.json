{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "贝来",
  "version": "0.1.0",
  "identifier": "com.blcj.android",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "贝来 收银系统",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "贝来",
    "copyright": "© 2026 贝来",
    "android": {
      "minSdkVersion": 24
    }
  }
}
